# Copy this file to .env and adjust as needed for local development.
# .env is gitignored; this example file is the one that's tracked.

# Port the gateway listens on.
PORT=8090

# Base URL of the acquiring bank (the Mountebank simulator started by docker-compose).
BANK_SIMULATOR_BASE_URL=http://localhost:8080

# Timeout for a single call to the bank.
BANK_CALL_TIMEOUT=5s

# debug / info / warn / error
LOG_LEVEL=info
